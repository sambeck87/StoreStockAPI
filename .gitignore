# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config and vendored gems.
/.bundle
/vendor/bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore key files for decrypting credentials and more.
/config/*.key

# Ignore OpenCode IDE config
.opencode/

# Ignore generated knowledge graph
graphify-out/

# Ignore Redis dump
dump.rdb

# Ignore OpenCode agent instructions
AGENTS.md

# Ignore test coverage output
coverage/

# Ignore RSpec persistent examples
spec/examples.txt

# Ignore debugger history
.byebug_history

# Ignore development Procfile (contains local config)
Procfile.dev

# Ignore node_modules (for any JS tooling)
node_modules/

