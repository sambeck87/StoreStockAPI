# Store Stock API — variables de entorno
# Copia este archivo a .env y completa los valores con los de TU entorno.
# NUNCA subas .env con valores reales al repositorio.

# PostgreSQL (producción usa DATABASE_URL; desarrollo/test usan DB_HOST + usuario/contraseña)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/store_stock_api_production
STORE_STOCK_API_DATABASE_NAME=store_stock_api_production
STORE_STOCK_API_DATABASE_USERNAME=your_db_user
STORE_STOCK_API_DATABASE_PASSWORD=your_db_password
DB_HOST=localhost

# Redis (cola de Sidekiq)
REDIS_URL=redis://localhost:6379/0

# SMTP saliente (correos de confirmación y restablecimiento de contraseña)
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_CA_FILE=/etc/ssl/certs/ca-certificates.crt
MAILER_FROM=no-reply@your-domain.com

# Hosts y CORS
APP_HOST=localhost
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# Clave maestra de Rails (descifra config/credentials.yml.enc)
RAILS_MASTER_KEY=your_rails_master_key

# Opcionales
# WORKER=true          # el contenedor arranca Sidekiq en lugar de Puma
# RAILS_MAX_THREADS=5  # hilos de Puma
# PORT=80              # puerto del servidor
# RAILS_LOG_LEVEL=info # nivel de log
